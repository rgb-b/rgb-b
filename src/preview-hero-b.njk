    /* Variation B — "giant type, no midtone": Dion Pieters' high-contrast,
       oversized display-type move. The wordmark is the loudest thing on
       the page (near-viewport-width, full weight, mono at rest rather
       than only on hover, since mobile has no hover state to reveal it).
       Everything else -- kicker, bio, links -- is pushed small and quiet
       underneath a hard rule, so the page reads as one huge gesture and
       one small footnote, nothing in between. */
    .pv-b {
        padding: var(--spacing-lg) 0 var(--spacing-lg);
    }
    .pv-b .kicker {
