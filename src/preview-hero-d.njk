    /* Variation D — A's structure (one merged opening statement, no
       redundant second "welcome" heading) at closer to B's scale, but
       fixing the two things that made A/B both read as flat/generic:
       (1) the wordmark reuses the REAL .var-title class instead of a
       fresh static clone, so it's actually tied to scroll velocity
       (--v) and the hover chromatic-aberration morph like everywhere
       else the wordmark appears on the site -- on mobile that means it
       has a small continuous reaction as you scroll instead of sitting
       dead; (2) the divider is a thin single-ink dot-screen strip
       (same halftone technique as the plates), not a flat solid-color
       bar -- nothing else on the site is a flat color fill, so a solid
       rule read as an outlier even without being able to name why. */
    .pv-d {
        padding: var(--spacing-lg) 0 var(--spacing-lg);
    }
    .pv-d .kicker {
        font-family: var(--font-display);
        font-variation-settings: "MONO" 1, "wght" 550;
        font-size: 11px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--color-accent);
        margin-bottom: var(--spacing-sm);
    }
    .pv-d .var-title {
        font-size: clamp(3.5rem, 19vw, 7.5rem);
        margin: 0 -1px var(--spacing-md);
    }
    .pv-d .screen-rule {
        position: relative;
        height: 10px;
        margin-bottom: var(--spacing-md);
        opacity: 0.8;
        background-size: 7px 7px;
        background-image: radial-gradient(
                circle at 25% 25%,
                var(--color-accent) 0 1px,
                transparent 1.3px
            ),
            radial-gradient(
                circle at 75% 75%,
                var(--color-accent) 0 1px,
                transparent 1.3px
            );
        mask-image: linear-gradient(
            to right,
            transparent,
            black 8%,
            black 92%,
            transparent
        );
        -webkit-mask-image: linear-gradient(
            to right,
            transparent,
            black 8%,
            black 92%,
            transparent
        );
    }
