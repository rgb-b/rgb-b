<!-- Projects section -->
<section id="projects">
    <h2>projects</h2>
    <div class="card-grid">
        {% for p in projects %}
        <div class="card">
            <h3>{{ p.name }}</h3>
            <p>{{ p.cardBlurb | safe }}</p>
            <p
                class="mono muted"
                style="margin-top: var(--spacing-xs)"
            >
                <a class="card-link" href="project-{{ p.slug }}.html">view &rarr;</a>
            </p>
        </div>
        {% endfor %}
        <!-- copy .card blocks to add more -->
    </div>
</section>

<!-- Cherry's Labs section -->
<section id="cherryslabs" class="accent-pink">
    <h2>cherry's labs</h2>
    <p>
        Cherry's Laboratories is a small lab studio run by a
        collection of nerds with a very diverse set of skills. We
        aim to create custom solutions for clients, research and
        development, and build out our ideas. The goal is
        collaborative learning and production, combining our skill
        sets into useful tools, software, hardware, and anything
        else. (more at
        <a href="https://cherryslabs.elphiene.com"
            >cherryslabs.com</a
        >).
    </p>
    <p>
        Informally, it's a design-and-dev studio &mdash; we take on
        client branding, build up their business presence, and build
        our own projects for fun, including a couple of the things
        listed above.
    </p>
    <p>
        My side of it is mostly design and ideas: brand identity,
        visual direction, and the R&amp;D thinking behind what we
        build next.
    </p>
</section>

<!-- Updates section -->
<section id="updates">
    <h2>update log</h2>
    <div class="updates-box">
        {% for entry in updates %}
        <div class="update-entry">
            <em>{{ entry.date }}</em>
            <pre>{{ entry.text }}</pre>
        </div>
        {% endfor %}
    </div>
</section>

