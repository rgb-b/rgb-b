<!-- Hero / intro — a merged masthead (status line, giant wordmark, a
     sentence headline, facts, links) rather than a separate hero
     section followed by a redundant "welcome" card. Built up over
     several rounds of on-device preview comparison. -->
<section id="intro">
    <h1 class="var-title hero-wordmark">rgb-b</h1>
    <p class="hero-status">
        el &middot; pre-press apprentice &middot; design + dev
    </p>
    <p class="hero-statement">
        I build the <em>tools</em> that don't exist, so you don't
        have to.
    </p>
    <div class="hero-rule" aria-hidden="true"></div>
    <div class="hero-facts">
        <span><b>&gt;</b> 21</span>
        <span><b>&gt;</b> art + IT</span>
        <span><b>&gt;</b> melbourne, australia</span>
        <span><b>&gt;</b> server admin</span>
        <span><b>&gt;</b> visual arts / print / design</span>
    </div>
    <div class="hero-links">
        <a href="https://www.linkedin.com/in/eloise-bartrop-braybon-407060212/"
            >linkedin</a
        >
        <a href="https://cherryslabs.com">cherry's labs</a>
        <a href="mailto:el@rgb-b.com">email</a>
    </div>
</section>

