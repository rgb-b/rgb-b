<!-- Hero title — the "rgb-b" wordmark, big, with a variable-font
     hover morph (Recursive's MONO/CASL/wght/slnt axes). Hover or
     tap to see it shift from a technical mono lean to a looser,
     heavier casual weight. -->
<section class="hero-title-section">
    <p class="kicker">
        el &middot; pre-press apprentice &middot; design + dev
    </p>
    <h1 class="var-title">rgb-b</h1>
</section>

<!-- Intro section -->
<section id="intro">
    <h2>welcome</h2>
    <div
        class="two-col mb-sm"
        style="margin-top: var(--spacing-sm)"
    >
        <div class="card visible">
            <h3>about</h3>
            <p>
                el | 21 | pre-press apprentice with a background in
                visual arts, design, and development. A rare
                combination of art and IT skills. R&amp;D tinkerer,
                enough networking knowledge to run my own servers,
                and manage others.
            </p>
            <p>Melbourne, Australia.</p>
        </div>
        <div class="card visible">
            <h3>links</h3>
            <p class="mono muted" style="margin-bottom: 4px">
                &gt;
                <a
                    href="https://www.linkedin.com/in/eloise-bartrop-braybon-407060212/"
                    >linkedin</a
                >
            </p>
            <p class="mono muted" style="margin-bottom: 4px">
                &gt;
                <a href="https://cherryslabs.elphiene.com"
                    >cherry's labs</a
                >
            </p>
            <p class="mono muted">
                &gt; <a href="mailto:el@rgb-b.com">email</a>
            </p>
        </div>
    </div>
</section>

<!-- Marquee strip (decorative — content is duplicated for the
     seamless loop, so it's hidden from assistive tech) -->
<div class="marquee-wrapper" aria-hidden="true">
    <div class="marquee-track">
        <!-- Replace these with real badge images or text badges -->
