<!-- Projects section -->
<section id="projects">
    <span class="section-kicker">the work</span>
    <h2>projects</h2>
    <div class="plate-grid">
        {% for p in projects %}
        {% set gridOrder = plateOrder[p.slug] %}
        <div
            class="plate-card"
            style="--order-1col: {{ gridOrder.c1 }}; --order-2col: {{ gridOrder.c2 }}; --order-3col: {{ gridOrder.c3 }};"
        >
            {% include "plate.njk" %}
            <p>{{ p.cardBlurb | safe }}</p>
        </div>
        {% endfor %}
        <!-- plate recipes live in src/_data/projects.js — copy an existing
             plate block (ink/depth/angle/pitch/icon/label/axis/wmFit) to
             add another project's plate here. Grid position is separate,
             driven by src/_data/plateOrder.js (see its own comment) -->
    </div>
</section>

<!-- Cherry's Labs section -->
<section id="cherryslabs" class="accent-pink">
    <span class="section-kicker">the studio</span>
    <h2>cherry's labs</h2>
    <p>
        Cherry's Laboratories is a small lab studio run by a
        collection of nerds with a very diverse set of skills. We
        aim to create custom solutions for clients, research and
        development, and build out our ideas. The goal is
        collaborative learning and production, combining our skill
        sets into useful tools, software, hardware, and anything
        else. (more at
        <a href="https://cherryslabs.com"
            >cherryslabs.com</a
        >).
    </p>
    <p>
        Informally, it's a design-and-dev studio &mdash; we take on
        client branding, build up their business presence, and build
        our own projects for fun, including a couple of the things
        listed above.
    </p>
    <p>
        My side of it is mostly design and ideas: brand identity,
        visual direction, and the R&amp;D thinking behind what we
        build next.
    </p>
</section>

<!-- Updates section -->
<section id="updates">
    <span class="section-kicker">log</span>
    <h2>update log</h2>
    <div class="updates-box">
        {% for entry in updates %}
        <div class="update-entry">
            <em>{{ entry.date }}</em>
            <pre>{{ entry.text }}</pre>
        </div>
        {% endfor %}
    </div>
</section>

