<style>
    .pv-note {
        background: rgba(0, 255, 204, 0.08);
        border: 1px solid var(--color-border);
        padding: var(--spacing-xs) var(--spacing-md);
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--color-text-muted);
        text-align: center;
