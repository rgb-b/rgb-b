<!-- Static wave-rule divider, reused under every major section heading
     (welcome / projects / cherry's labs / update log) so the "the divider
     is a waveform" motif reads as a running visual language rather than a
     one-off flourish scoped to a single section. Stroke color follows
     --color-accent by default; .accent-pink sections (Cherry's Labs)
     override it to --color-accent-alt via CSS, matching how that
     section's h2 already recolors itself. Never animates. -->
<svg
    class="wave-rule"
    viewBox="0 0 240 6"
    preserveAspectRatio="none"
    aria-hidden="true"
>
    <path
        d="M0,3 C10,0.5 20,0.5 30,3 C40,5.5 50,5.5 60,3 C70,0.5 80,0.5 90,3 C100,5.5 110,5.5 120,3 C130,0.5 140,0.5 150,3 C160,5.5 170,5.5 180,3 C190,0.5 200,0.5 210,3 C220,5.5 230,5.5 240,3"
        fill="none"
        vector-effect="non-scaling-stroke"
    />
</svg>
