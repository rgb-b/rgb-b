<!-- Ambient background — a 3D teal/pink/blue particle field in Three.js
     (CDN script tag, no bundler), sitewide via base.njk. Replaces an
     earlier flat 2D dither-canvas attempt that el didn't like (looked
     "weird and squished," washed out where colors overlapped, and never
     visibly reacted to scroll). This is a genuine sphere (no axis
     flattening this time), colored from the site's actual teal/pink/blue
     tokens, and scroll velocity (--v / window.__rgbbV, published by
     velocity.njk) drives both the field's spin speed and a camera dolly,
     so scrolling has an obvious, undeniable effect on it rather than a
     subtle secondary one. Pointer position still nudges the camera for a
     light parallax feel. Static single frame under prefers-reduced-motion. -->
<canvas id="bg-canvas" aria-hidden="true"></canvas>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
    (function () {
        var canvas = document.getElementById("bg-canvas");
        if (!canvas || !window.THREE) return;

        var reduceMotion =
            window.matchMedia &&
            window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        var renderer;
        try {
            renderer = new THREE.WebGLRenderer({
                canvas: canvas,
                alpha: true,
                antialias: true,
            });
        } catch (e) {
            return; /* no WebGL -- page still reads fine without it */
        }
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

        var scene = new THREE.Scene();
        scene.fog = new THREE.FogExp2(0x050505, 0.02);

        var camera = new THREE.PerspectiveCamera(55, 1, 0.1, 100);
        var BASE_Z = 22;
        camera.position.z = BASE_Z;

        /* Three true ink plates, not two -- teal/pink/blue at roughly the
           site's own 7:3:1 accent ratio, matching the palette everywhere
           else on the page instead of drifting from it. */
        var COUNT = 900;
        var positions = new Float32Array(COUNT * 3);
        var colors = new Float32Array(COUNT * 3);
        var teal = new THREE.Color(0x00ffcc);
        var pink = new THREE.Color(0xff44aa);
        var blue = new THREE.Color(0x6c7bff);

        for (var i = 0; i < COUNT; i++) {
            /* A true sphere -- the original version flattened the y-axis
               to 0.4x, which read as a squashed disc rather than a field
               with real depth. Cube-root radius keeps the distribution
               volumetric (even density through the sphere) instead of
               clumping at the core. */
            var r = 20 * Math.cbrt(Math.random());
            var theta = Math.random() * Math.PI * 2;
            var phi = Math.acos(2 * Math.random() - 1);
            positions[i * 3] = r * Math.sin(phi) * Math.cos(theta);
            positions[i * 3 + 1] = r * Math.sin(phi) * Math.sin(theta);
            positions[i * 3 + 2] = r * Math.cos(phi);

            var roll = Math.random();
            var c = roll > 0.9 ? blue : roll > 0.65 ? pink : teal;
            colors[i * 3] = c.r;
            colors[i * 3 + 1] = c.g;
            colors[i * 3 + 2] = c.b;
        }

        var geo = new THREE.BufferGeometry();
        geo.setAttribute("position", new THREE.BufferAttribute(positions, 3));
        geo.setAttribute("color", new THREE.BufferAttribute(colors, 3));

        var mat = new THREE.PointsMaterial({
            size: 0.09,
            vertexColors: true,
            transparent: true,
            opacity: 0.62,
            sizeAttenuation: true,
        });

        var points = new THREE.Points(geo, mat);
        scene.add(points);

        function resize() {
            var w = window.innerWidth;
            var h = window.innerHeight;
            renderer.setSize(w, h, false);
            camera.aspect = w / h;
            camera.updateProjectionMatrix();
        }
        resize();
        window.addEventListener("resize", resize);

        var mouseX = 0,
            mouseY = 0;
        window.addEventListener("pointermove", function (e) {
            mouseX = (e.clientX / window.innerWidth - 0.5) * 2;
            mouseY = (e.clientY / window.innerHeight - 0.5) * 2;
        });

        function render() {
            var v = (typeof window !== "undefined" && window.__rgbbV) || 0;
            var av = Math.abs(v);

            /* Scroll drives this directly instead of receding from it --
               spin speeds up to ~6x resting rate and the camera dollies
               in toward the field at max velocity, so scrolling visibly
               does something to the background rather than just being
               tracked by a CSS variable nothing reacts to. */
            points.rotation.y += 0.0006 + av * 0.003 * Math.sign(v || 1);
            points.rotation.x += 0.00015 + av * 0.0008;
            var targetZ = BASE_Z - av * 6;
            camera.position.z += (targetZ - camera.position.z) * 0.08;

            camera.position.x += (mouseX * 2 - camera.position.x) * 0.015;
            camera.position.y += (-mouseY * 1.2 - camera.position.y) * 0.015;
            camera.lookAt(0, 0, 0);
            renderer.render(scene, camera);
        }

        if (reduceMotion) {
            render();
        } else {
            (function loop() {
                render();
                requestAnimationFrame(loop);
            })();
        }
    })();
</script>
