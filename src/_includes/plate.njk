<a
    class="plate plate--{{ p.plate.ink }} plate--d{{ p.plate.depth }} plate--{{ p.plate.pitch }} plate--angle-{{ p.plate.angle }}{% if p.plate.face %} plate--face-{{ p.plate.face }}{% endif %}"
    style="--wm-fit: {{ p.plate.wmFit }}"
    href="project-{{ p.slug }}.html"
    aria-label="{{ p.name }} — {{ p.plate.label }}"
>
    <div class="plate-head">
        <svg
            class="plate-icon"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="0.55"
            stroke-linecap="square"
            stroke-linejoin="miter"
            aria-hidden="true"
        >
            {% include "icons/" + p.plate.icon + ".njk" %}
        </svg>
        <span class="plate-label">{{ p.plate.label }}</span>
        <span class="plate-rule"></span>
    </div>
    <span
        class="plate-wordmark"
        {% if p.plate.face == "alt" %}style="font-variation-settings: 'wdth' {{ p.plate.axis.wdth }}, 'wght' {{ p.plate.axis.wght }}"{% elif p.plate.face == "serif" %}{# Gloock is a static face — no variation settings #}{% else %}style="font-variation-settings: 'MONO' {{ p.plate.axis.mono }}, 'CASL' {{ p.plate.axis.casl }}, 'wght' {{ p.plate.axis.wght }}, 'slnt' {{ p.plate.axis.slnt }}"{% endif %}
        >{{ p.name }}</span
    >
    <span class="plate-strip" aria-hidden="true">
        <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
    </span>
    <span class="plate-crop" aria-hidden="true"></span>
</a>
