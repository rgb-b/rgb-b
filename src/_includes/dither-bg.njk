<!-- Animated RGB-screen background — a low-res canvas scaled up with
     no smoothing, so it reads as a chunky halftone screen. The same
     halftone pattern is sampled three times, once per ink plate
     (teal/pink/blue), each nudged by its own slow "registration drift"
     offset on a ~45s cycle -- real presses would call this
     misregistration. Plates converge into solid colour when their
     offsets line up and split into coloured fringes when they don't.
     A few rows per frame additionally tear sideways for a glitched-
     signal look. Keeps clear of the middle of the viewport so body
     copy stays legible. Fades in once the first frame is drawn so it
     never blocks paint; static single frame for anyone with
     prefers-reduced-motion set. -->
<canvas id="dither-bg" aria-hidden="true"></canvas>
<script>
    (function () {
        var canvas = document.getElementById("dither-bg");
        if (!canvas || !canvas.getContext) return;
        var ctx = canvas.getContext("2d");
        var W = 480,
            H = 270;
        canvas.width = W;
        canvas.height = H;

        /* 8x8 Bayer — finer gradation than a 4x4, which is what lets
           the cells get small without the ramp banding into blobs. */
        var bayer = [
            [0, 32, 8, 40, 2, 34, 10, 42],
            [48, 16, 56, 24, 50, 18, 58, 26],
            [12, 44, 4, 36, 14, 46, 6, 38],
            [60, 28, 52, 20, 62, 30, 54, 22],
            [3, 35, 11, 43, 1, 33, 9, 41],
            [51, 19, 59, 27, 49, 17, 57, 25],
            [15, 47, 7, 39, 13, 45, 5, 37],
            [63, 31, 55, 23, 61, 29, 53, 21],
        ];

        /* teal accent, hot pink, cold blue (= --color-blue-500 / #6C7BFF) */
        var PALETTE = [
            [0, 255, 204],
            [255, 68, 170],
            [108, 123, 255],
        ];

        var img = ctx.createImageData(W, H);

        function fract(n) {
            return n - Math.floor(n);
        }

        /* Registration drift: each plate orbits a tiny ellipse at its
           own frequency so the three periods only line back up (full
           registration) roughly every ~45s, rather than breathing in
           and out in lockstep. Amplitude is small (buffer is only
           480x270) -- this is meant to read as a few px of print
           misregistration, not a visible wobble. */
        var DRIFT_AMP = 1.6;
        var DRIFT_FREQ = [
            [0.071, 0.053],
            [0.098, 0.062],
            [0.084, 0.115],
        ];
        var DRIFT_PHASE = [0, 2.09, 4.19]; // 2*pi/3 apart

        function plateOffset(plate, t) {
            var f = DRIFT_FREQ[plate];
            var p = DRIFT_PHASE[plate];
            return [
                Math.sin(t * f[0] + p) * DRIFT_AMP,
                Math.cos(t * f[1] + p) * DRIFT_AMP,
            ];
        }

        function sampleMask(x, y, t, shift, wave) {
            var sx = x + shift;
            var v =
                (Math.sin(sx * 0.09 + t * 0.6) * wave * 0.5 +
                    Math.sin(sx * 0.04 + y * 0.06 + t * 0.3) * 0.5 +
                    1) /
                2;

            /* fade out of the middle so body copy keeps its
               contrast against the cards */
            var nx = (x / W - 0.5) * 2;
            var rowEdge = ((y / H - 0.5) * 2) ** 2 * 0.55;
            var edge = Math.min(1, nx * nx * 0.95 + rowEdge);
            v = Math.max(0, Math.min(1, v * edge));

            /* Bayer lookup needs integer cell coordinates -- x/y arrive
               fractional here whenever a drifted plate offset is baked in
               (see plateOffset), and indexing the table with a fractional
               key returns undefined, which used to throw and kill the
               whole render() call before it ever painted a frame. */
            var by = Math.floor(y);
            var bx = Math.floor(x);
            return (
                v >
                (bayer[((by % 8) + 8) % 8][((bx % 8) + 8) % 8] + 0.5) / 64
            );
        }

        function render(t) {
            /* Scroll-velocity coupling: the ambient canvas recedes while
               the page is moving fast, so the foreground (plate parallax /
               marquee stagger) reads as the thing actually responding to
               the scroll. Also a perf win -- see the throttle in loop(). */
            var v = (typeof window !== "undefined" && window.__rgbbV) || 0;
            var ampScale = 1 - 0.3 * Math.abs(v);

            var data = img.data;
            for (var y = 0; y < H; y++) {
                /* a couple of row-bands per frame tear sideways --
                   an occasional CRT-style glitch on top of the slow
                   plate drift */
                var noise = fract(
                    Math.sin(
                        Math.floor(y / 2) * 12.9898 +
                            Math.floor(t * 3) * 7.233,
                    ) * 43758.5453,
                );
                var isGlitch = noise > 0.972;
                var glitchShift = isGlitch
                    ? Math.floor((noise - 0.972) * 900) - 12
                    : 0;
                var scan = y % 2 === 0 ? 1 : 0.78; /* CRT scanline */
                var wave = Math.sin(y * 0.11 - t * 0.45) * ampScale;

                for (var x = 0; x < W; x++) {
                    var i = (y * W + x) * 4;

                    /* halftone screen: 2x2 cells with a 1px gutter */
                    if (x % 3 === 2 || y % 3 === 2) {
                        data[i + 3] = 0;
                        continue;
                    }

                    if (isGlitch) {
                        /* a torn row snaps to a single plate rather
                           than compositing all three -- reads as a
                           signal dropout, not just misregistration */
                        var on = sampleMask(x, y, t, glitchShift, wave);
                        if (!on) {
                            data[i + 3] = 0;
                            continue;
                        }
                        var gcol = PALETTE[noise > 0.986 ? 1 : 2];
                        data[i] = gcol[0];
                        data[i + 1] = gcol[1];
                        data[i + 2] = gcol[2];
                        data[i + 3] = 78;
                        continue;
                    }

                    /* composite the three ink plates, each sampled at its
                       own drifted position, as translucent layers (real
                       "src over" alpha compositing, teal under pink under
                       blue) rather than averaging their RGB together --
                       averaging three saturated, differently-hued colors
                       collapses straight to grey wherever they agree, which
                       reads as "no color at all" exactly where the effect
                       should look most in-register. Layering keeps each
                       plate's own hue readable, with the ones underneath
                       showing through faintly rather than being blended
                       flat. */
                    var cr = 0,
                        cg = 0,
                        cb = 0,
                        ca = 0,
                        hits = 0;
                    for (var p = 0; p < 3; p++) {
                        var off = plateOffset(p, t);
                        if (
                            sampleMask(
                                x + off[0] * ampScale,
                                y + off[1] * ampScale,
                                t,
                                0,
                                wave,
                            )
                        ) {
                            var col = PALETTE[p];
                            var srcA = 0.62;
                            cr = col[0] * srcA + cr * (1 - srcA);
                            cg = col[1] * srcA + cg * (1 - srcA);
                            cb = col[2] * srcA + cb * (1 - srcA);
                            ca = srcA + ca * (1 - srcA);
                            hits++;
                        }
                    }

                    if (hits === 0) {
                        data[i + 3] = 0;
                        continue;
                    }

                    data[i] = cr;
                    data[i + 1] = cg;
                    data[i + 2] = cb;
                    /* more plates agreeing on a pixel reads as more
                       "in register" -- give it a touch more ink */
                    data[i + 3] = Math.round(
                        ca * (34 + hits * 14) * scan,
                    );
                }
            }
            ctx.putImageData(img, 0, 0);
        }

        var reduceMotion =
            window.matchMedia &&
            window.matchMedia("(prefers-reduced-motion: reduce)")
                .matches;

        function fadeIn() {
            requestAnimationFrame(function () {
                canvas.style.opacity = 1;
            });
        }

        render(0);
        fadeIn();

        if (!reduceMotion) {
            var last = 0;
            var rafId = null;
            var running = false;

            function loop(ts) {
                var v = (typeof window !== "undefined" && window.__rgbbV) || 0;
                /* ~30fps cap, stretching to ~13fps at max scroll velocity --
                   the canvas is receding anyway, so it can afford to draw
                   less often exactly when scroll perf matters most. */
                var throttle = 33 + 60 * Math.abs(v);
                if (ts - last > throttle) {
                    render(ts / 1000);
                    last = ts;
                }
                rafId = requestAnimationFrame(loop);
            }

            function start() {
                if (running) return;
                running = true;
                rafId = requestAnimationFrame(loop);
            }

            function stop() {
                running = false;
                if (rafId !== null) cancelAnimationFrame(rafId);
                rafId = null;
            }

            document.addEventListener("visibilitychange", function () {
                if (document.hidden) {
                    stop();
                } else {
                    start();
                }
            });

            if (!document.hidden) start();
        }
    })();
</script>
