    /* E2 — indented "spec block": the bio hangs off a left rule, offset
       from the wordmark's own left edge instead of sharing it, like a
       caption indented under a figure. Two distinct type voices instead
       of one uniform paragraph size: the identity line in the same
       display face as the section headings (Bricolage Grotesque, so the
       hero finally shares a voice with "welcome"/"projects" below it
       instead of being its own third typeface), the facts line in small
       tracked mono -- a spec sheet, not a paragraph. */
    .pv-e2 .stack {
        margin-left: 18px;
        padding-left: var(--spacing-md);
        border-left: 1px solid var(--color-border);
    }
    .pv-e2 .headline {
        font-family: var(--font-display-alt);
        font-variation-settings: "wdth" 100, "wght" 600;
        font-size: 21px;
        line-height: 1.35;
        letter-spacing: -0.01em;
        color: var(--color-text);
        margin-bottom: var(--spacing-sm);
    }
    .pv-e2 .facts {
        display: grid;
        gap: 4px;
        margin-bottom: var(--spacing-md);
    }
    .pv-e2 .facts span {
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.04em;
        color: var(--color-text-muted);
    }
    .pv-e2 .facts span b {
        color: var(--color-accent);
        font-weight: 400;
    }
    .pv-e2 .inline-links {
        display: flex;
        gap: var(--spacing-md);
    }
    .pv-e2 .inline-links a {
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.04em;
        color: var(--color-text-muted);
    }
    .pv-e2 .inline-links a:hover {
        color: var(--color-accent);
        text-decoration: none;
    }
</style>

