    /* E1 — centered, single merged block. One idea: identity, skills,
       location all as one sentence-driven paragraph at a real reading
       size (not a tiny caption), centered under the equally-centered
       kicker/wordmark instead of the left-aligned block every other
       variant tried. No split lede/footnote hierarchy -- the two
       previous blocks become one. */
    .pv-e1 {
        text-align: center;
    }
    .pv-e1 .kicker,
    .pv-e1 .screen-rule {
        margin-left: auto;
        margin-right: auto;
    }
    .pv-e1 .bio {
