    /* Variation H — same styling ingredients as G (which read as "worse"
       despite hitting every individual note el asked for), but G's real
       problem wasn't styling: the kicker, the serif line, one fact, and
       the pink-highlighted fact all said "art + IT / pre-press apprentice"
       in four different typefaces. Four voices repeating one idea reads
       as bloat no matter how each individual line is styled. Fixed by
       giving every block something to say that nothing else says --
       kicker=role, serif=thesis, facts=three genuinely new details,
       nothing restated. Also dropped the vertical guide-rule beside the
       facts (a third rule device alongside the dot-screen divider and the
       link row's top border -- one too many graphic elements) and moved
       the pink touch off a restated line onto a real, distinct one. */
    .pv-h {
        padding: var(--spacing-lg) 0 var(--spacing-lg);
    }
    .pv-h .kicker {
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--color-text-muted);
        margin-bottom: var(--spacing-sm);
    }
    .pv-h .var-title {
        font-size: clamp(4rem, 24vw, 8.5rem);
        line-height: 0.85;
        margin: 0 -2px var(--spacing-md);
        font-variation-settings:
            "MONO" 0.85,
            "CASL" 0,
            "wght" calc(720 + var(--v) * 90),
            "slnt" calc(-3 + var(--v) * -12);
    }
    .pv-h .screen-rule {
        height: 10px;
        margin-bottom: var(--spacing-lg);
        opacity: 0.8;
        background-size: 7px 7px;
        background-image: radial-gradient(
                circle at 25% 25%,
                var(--color-accent) 0 1px,
                transparent 1.3px
            ),
            radial-gradient(
                circle at 75% 75%,
                var(--color-accent) 0 1px,
                transparent 1.3px
            );
        mask-image: linear-gradient(
            to right,
            transparent,
            black 8%,
            black 92%,
            transparent
        );
        -webkit-mask-image: linear-gradient(
            to right,
            transparent,
            black 8%,
            black 92%,
            transparent
        );
    }
    .pv-h .editorial {
        font-family: var(--font-display-serif);
        font-size: 23px;
        line-height: 1.4;
        max-width: 22ch;
        color: var(--color-text);
        margin-bottom: var(--spacing-md);
    }
    .pv-h .facts {
        display: grid;
