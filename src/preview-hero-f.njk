    /* Variation F — B's near-viewport wordmark scale and boldness (but
       still real, tied to .var-title/--v, not a static clone) + E2's
       structural device (a rule-offset block, two distinct type voices
       instead of one paragraph size) + E3's break from the wordmark's own
       left edge -- the body block sets against the RIGHT instead of
       sharing the wordmark's alignment, with the rule flipped to the
       right side and its content right-set, so the two elements pull in
       opposite directions instead of stacking on one shared edge. */
    .pv-f {
        padding: var(--spacing-lg) 0 var(--spacing-lg);
    }
